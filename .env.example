# ==============================================================================
# SariTrack Unified Environment & Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or use the tier-specific configuration files:
# - Backend: backend/src/main/resources/application-local.properties
# - Web: web/.env
# - Mobile: edu/cit/tapales/saritrack/core/api/RetrofitClient.kt
#
# NEVER COMMIT REAL SECRETS TO GIT REPOSITORIES!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (Spring Boot 3 / Java 17)
# ------------------------------------------------------------------------------
PORT=8080

# Supabase PostgreSQL Connection Pooler (Port 6543, Transaction Mode)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.your-project-ref
SPRING_DATASOURCE_PASSWORD=your-database-password

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PayMongo Sandbox Credentials
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret

# Gmail SMTP Gateway (Automated Transaction Receipts & Alerts)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_digit_gmail_app_password

# Frontend Application Origin (For PayMongo checkout redirects & CORS)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. WEB FRONTEND (React 18 / Vite / Tailwind CSS)
# ------------------------------------------------------------------------------
# API Base Endpoint (Points to Spring Boot backend)
VITE_API_URL=http://localhost:8080

# Supabase Public CDN Storage (For product catalog images)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# ------------------------------------------------------------------------------
# 3. MOBILE APP (Android Kotlin / Retrofit 2)
# ------------------------------------------------------------------------------
# In RetrofitClient.kt:
# - Android Studio Emulator: http://10.0.2.2:8080/
# - Physical Device on LAN:  http://<YOUR_LAN_IP>:8080/
# - Production / Cloud:      https://<YOUR_DEPLOYED_BACKEND_URL>/
