# Web Environment Configuration Template
# Copy this file to .env and replace the placeholder values.
# NEVER commit the actual .env file to Git!

# Backend API URL (Use http://localhost:8080 for local, or your deployed Render URL for production)
VITE_API_URL=http://localhost:8080

# Supabase Credentials (Public Anon Key is safe for client-side use)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
